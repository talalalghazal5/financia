// use prisma-8
model User {
  id           Uuid                       @id @default(uuid())
  name         String
  email        String                     @unique
  passwordHash String
  transactions Transaction[]
  createdAt    TimestamptzString          @default(now())
  updatedAt    temporal.updatedAtString()
}

model Category {
  id            Uuid          @id @default(uuid())
  name          String
  monthlyBudget Float
  color         String
  transactions  Transaction[]
}

model Transaction {
  id          Uuid              @id @default(uuid())
  userId      Uuid
  categoryId  Uuid
  title       String
  amount      Float
  user        User              @relation(fields:[userId], references:[id])
  category    Category          @relation(fields:[categoryId], references:[id])
  type        Type              @default(expense)
  date        TimestamptzString @default(now())
  isRecurring Boolean
}

enum Type {
  expense
  income
}
